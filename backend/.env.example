# Servidor
PORTA=3000
HOST=0.0.0.0

# Banco de Dados PostgreSQL com pgvector
URL_BANCO_DADOS=postgres://docmind:docmind123@localhost:5432/docmind

# Provedores de IA: "simulado" (padrão para testes locais sem gastar créditos), "gemini" ou "openai"
PROVEDOR_VETOR=simulado
PROVEDOR_LLM=simulado

# Dimensões do vetor: 768 para Gemini / Simulado, 1536 para OpenAI text-embedding-3-small
DIMENSAO_VETOR=768

# Chaves de API (necessárias apenas se PROVEDOR_VETOR ou PROVEDOR_LLM != 'simulado')
CHAVE_GEMINI=
CHAVE_OPENAI=

# Armazenamento de arquivos
DIRETORIO_UPLOADS=./uploads
